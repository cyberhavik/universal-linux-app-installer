[Desktop Entry]
Version=1.0
Type=Application
Name=Universal Linux App Installer
GenericName=macOS-Style Universal Package Drag & Drop Installer
Comment=Drag & drop any .deb, .rpm, .AppImage, .pkg.tar.zst, .apk, .flatpak, or .tar.gz to install or uninstall automatically
Exec=uapp %f
Icon=com.astro.UniversalAppInstaller
Terminal=false
StartupNotify=true
Categories=System;PackageManager;Utility;
MimeType=application/x-rpm;application/x-redhat-package-manager;application/vnd.debian.binary-package;application/x-deb;application/x-appimage;application/vnd.flatpak;application/x-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;
StartupWMClass=com.astro.UniversalAppInstaller
Keywords=uapp;universal;rpm;deb;appimage;flatpak;arch;installer;uninstaller;drag;drop;app;package;
